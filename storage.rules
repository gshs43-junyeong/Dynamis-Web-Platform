rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─────────────────────────────────────────────────────────────────────
    // M-3 (읽기 증폭 방어) 근본 해법의 Storage 쪽 절반.
    //
    // 첨부 실 바이트는 여기로 옮기고, Firestore(firebase.rules)에는
    // fileName/fileSize/storagePath 메타데이터만 남긴다. 그래서 실제 크기·MIME
    // 검증은 여기서 해야 한다 — Firestore 쪽 isAllowedAttachment()는 이제
    // 스키마와 "이 notice/event에 실제로 업로드된 경로가 맞는지"만 볼 뿐, 바이트
    // 자체를 볼 방법이 없다.
    //
    // Cross-service 규칙(firestore.get())은 한 번의 규칙 평가에서 Firestore
    // 문서를 최대 2개까지만 읽을 수 있다. 아래 write 규칙은 users/{uid}(역할
    // 확인)와 notices|events/{id}(작성자 확인) 두 개만 읽도록 맞춰 뒀다 —
    // 세 번째 문서를 읽는 조건을 추가하면 한도를 넘겨 규칙이 항상 거부로
    // 평가될 수 있으니 주의할 것.
    // ─────────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // firebase.rules의 selfRole()과 동일한 판정을 Storage 쪽에서도 쓴다.
    function myRole() {
      return isSignedIn() && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
             ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
             : 'none';
    }

    function isAdmin() {
      return myRole() == 'admin';
    }

    // 명예부원은 첨부 업로드 자체가 금지 — firebase.rules의 isAllowedAttachment()와
    // 같은 정책이다.
    function isHonored() {
      return myRole() == 'honored';
    }

    // 파일당 700KB — firebase.rules의 fileEntryOk(...,700000)와 반드시 같은 값을
    // 유지해야 한다. 여기서만 올리고 저기서만 검증하는 게 아니라, 업로드는 여기서
    // 막고 메타데이터의 자기신고 fileSize는 저기서 다시 한 번 상한을 대조한다.
    function withinSizeLimit() {
      return request.resource.size <= 700000;
    }

    // 브라우저가 능동 콘텐츠로 렌더링/실행할 수 있는 MIME은 차단한다. 이 사이트는
    // 학술 자료(hwp/pptx/zip 등)를 주고받는 용도라 허용 목록 방식은 정상 사용을
    // 깨뜨리므로, firebase.rules의 L-1 조치와 동일하게 차단 목록 방식을 쓴다.
    function isSafeContentType() {
      return !request.resource.contentType.matches(
        '(?i).*(text/html|image/svg\\+xml|application/xhtml\\+xml|text/xml|application/xml|text/javascript|application/javascript|application/x-javascript).*'
      );
    }

    match /attachments/notices/{noticeId}/{fileId} {
      allow read: if true;
      allow write: if isSignedIn()
                   && !isHonored()
                   && withinSizeLimit()
                   && isSafeContentType()
                   && (firestore.get(/databases/(default)/documents/notices/$(noticeId)).data.authorId == request.auth.uid
                       || isAdmin());
      allow delete: if isSignedIn()
                   && (firestore.get(/databases/(default)/documents/notices/$(noticeId)).data.authorId == request.auth.uid
                       || isAdmin());
    }

    match /attachments/events/{eventId}/{fileId} {
      allow read: if true;
      allow write: if isSignedIn()
                   && !isHonored()
                   && withinSizeLimit()
                   && isSafeContentType()
                   && (firestore.get(/databases/(default)/documents/events/$(eventId)).data.authorId == request.auth.uid
                       || isAdmin());
      allow delete: if isSignedIn()
                   && (firestore.get(/databases/(default)/documents/events/$(eventId)).data.authorId == request.auth.uid
                       || isAdmin());
    }

    // 그 외 경로는 전부 차단 — 이 버킷에 첨부 말고 다른 용도가 생기기 전까지는
    // 화이트리스트 방식을 유지한다.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
