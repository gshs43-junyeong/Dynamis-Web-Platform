rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // collectionGroup('comments') 지원.
    // 회원 탈퇴 시 본인이 작성한 댓글을 공지/이벤트 전반에서 한 번에 조회하려면
    // 재귀 와일드카드 경로 규칙이 있어야 그룹 쿼리가 허용된다.
    // (개별 문서 접근은 각 부모 밑의 구체 규칙이 그대로 적용되고, 여기서는 조회만 연다)
    //
    // ⚠️ 재귀 와일드카드(**)라서 "앞으로 만들 모든" comments 하위 컬렉션이 자동으로
    // 전체 공개가 된다. 예를 들어 비공개 용도로 users/{uid}/comments 같은 걸 새로
    // 추가하는 순간 아무 조치 없이 인터넷에 열린다. 지금 존재하는 comments(공지·이벤트)는
    // 모두 공개가 맞아서 문제가 없을 뿐이므로, 새 comments 하위 컬렉션을 만들 때는
    // 반드시 이 규칙을 먼저 확인할 것.
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

    // 1. notices
    match /notices/{noticeId} {
      allow read: if true;

      // 작성 권한은 서버가 users 문서의 실제 role로 판정한다.
      // 클라이언트가 보낸 authorRole/authorName/authorBatch는 신뢰하지 않고
      // 요청자 본인의 users 문서와 일치하는지 대조한다(작성자·등급 사칭 차단).
      //
      // pinned: "고정"은 관리자 전용 기능(togglePin())이지만, 클라이언트가 항상
      // pinned:false로 생성해 왔을 뿐 규칙에는 이를 강제하는 조건이 없었다. 즉
      // 일반 부원도 addDoc 시 pinned:true를 직접 실어 보내면 자기 글을 최상단에
      // 셀프 고정할 수 있었다(에뮬레이터로 실측 확인). 생성 시 관리자가 아니면
      // pinned는 반드시 false여야 한다.
      //
      // isFreshTimestamp: isValidEvent에는 있었는데 이쪽엔 빠져 있었다 — timestamp를
      // 미래값(예: 9999999999999)으로 보내면 정렬(displayNoticesGlobal의 timestamp
      // desc)상 항상 최상단에 노출되어 고정 글보다도 위에 뜰 수 있었다.
      // isValidNotice() 안에 넣지 않고 여기 top-level 조건으로 둔 이유: isValidNotice
      // 내부에 중첩해서 underQuota()와 함께 평가하면 에뮬레이터에서 재현되는 이상
      // 동작(요청이 잘못된 timestamp로도 조용히 통과됨)이 있었다. 동일 함수를
      // top-level로 옮기니 문제없이 동작해, 원인 규명 없이 안전하게 검증된 이 형태로 둔다.
      allow create: if canPostNotice()
                    && isValidNotice(request.resource.data)
                    && isAuthenticAuthor(request.resource.data)
                    && isAllowedAttachment(request.resource.data)
                    && (isAdmin() || request.resource.data.get('pinned', false) == false)
                    && isFreshTimestamp(request.resource.data.timestamp)
                    && underQuota('noticeCount', 5);

      allow update: if request.auth != null
                    && (
                      (resource.data.authorId == request.auth.uid
                       && isValidNotice(request.resource.data)
                       && isAllowedAttachment(request.resource.data)
                       && authorAndTimeUnchanged()
                       // pinned 변경도 관리자 전용: 본인 수정 경로에서는 값을 그대로 유지해야 한다
                       // (마찬가지로 실측 확인된 셀프 고정 우회 — update 경로도 동일하게 막는다).
                       && request.resource.data.get('pinned', false) == resource.data.get('pinned', false))
                      || isAdmin()
                    );

      allow delete: if request.auth != null
                    && (resource.data.authorId == request.auth.uid || isAdmin());

      // 본문(content/files)은 카드와 분리된 문서에 둔다 — events가 이미 쓰는 것과
      // 같은 구조다. 예전에는 본문과 첨부(최대 700KB × 10개)가 카드 문서 안에
      // 그대로 들어 있어서, 목록만 보려고 들어온 방문자도 화면에 안 보여줄
      // 첨부·본문 바이트를 전부 내려받았다. 공지 100건에 첨부가 붙어 있으면
      // 홈 화면 진입 한 번으로 수십 MB가 나가는 구조였고, 이게 그대로 Firestore
      // 대역폭 비용(그리고 무료 티어 소진 시 유료 청구)으로 이어졌다.
      //
      // 카드에는 title/작성자/날짜/태그/pinned/timestamp/hasFiles(첨부 유무 표시용
      // 불리언 하나)만 남기고, 실제 본문과 첨부는 목록을 열 때가 아니라 그 글을
      // "클릭해서 열 때"만 이 서브컬렉션에서 따로 읽어온다.
      //
      // 이 프로젝트는 이 규칙 파일에서 기존 공지를 일괄 이관할 방법이 없어(운영
      // Firestore에 직접 쓰기 권한이 없음), 이미 만들어진 공지는 카드 문서 안에
      // content/files가 그대로 남아 있다 — isValidNotice()가 이 필드들을 "있으면
      // 검증하되 필수로 요구하지 않는" 형태로 둔 이유다. 렌더링 쪽(notice.js)이
      // 카드에 content가 있으면 옛 형태로 바로 보여주고, 없으면 이 서브컬렉션에서
      // 읽어오는 두 갈래로 나뉜다.
      match /content/{contentId} {
        allow read: if true;
        allow create, update: if request.auth != null
                    && contentId == 'main'
                    && isValidNoticeContent(request.resource.data)
                    && isAllowedAttachment(request.resource.data)
                    && (noticeAuthorId(database, noticeId) == request.auth.uid || isAdmin());
        allow delete: if request.auth != null
                    && (noticeAuthorId(database, noticeId) == request.auth.uid || isAdmin());
      }

      match /comments/{commentId} {
        allow read: if true;
        // isFreshTimestamp를 isValidComment 안이 아니라 여기 top-level에 두는 이유는
        // 공지 create 규칙의 주석과 같다(underQuota와 중첩 평가 시의 이상 동작 회피).
        allow create: if request.auth != null
                      && isValidComment(request.resource.data)
                      && isAuthenticAuthor(request.resource.data)
                      && isFreshTimestamp(request.resource.data.timestamp)
                      && underQuota('commentCount', 10);
        // 수정은 본인만, 그것도 본문(content)만. 작성자 표기와 timestamp는 잠근다.
        // 관리자에게 주는 모더레이션 수단은 "삭제"이지 "남의 말 고쳐 쓰기"가 아니므로
        // update에서 isAdmin() 분기를 뺐다(현재 클라이언트에 댓글 수정 UI도 없다).
        allow update: if request.auth != null
                      && resource.data.authorId == request.auth.uid
                      && isValidComment(request.resource.data)
                      && authorAndTimeUnchanged();
        allow delete: if request.auth != null
                      && (resource.data.authorId == request.auth.uid || isAdmin());
      }

      // 한 계정당 하트 1회, 취소 불가 (docId == 누른 사람 uid)
      match /likes/{likeId} {
        allow read: if true;
        allow create: if request.auth != null
                      && likeId == request.auth.uid
                      && isValidLike(request.resource.data, request.auth.uid);
        allow update, delete: if false;
      }
    }

    // 2. events (notice와 동일한 구조 + 마감 타이머)
    //    - 목록 카드(events/{eventId})는 항상 읽기 가능 (제목/작성자/마감시각)
    //    - 본문(events/{eventId}/content/main)은 마감 전에만 서버가 열어줌
    match /events/{eventId} {
      allow read: if true;

      allow create: if canPostNotice()
                    && isValidEvent(request.resource.data)
                    && isAuthenticAuthor(request.resource.data)
                    && underQuota('eventCount', 5);

      allow update: if request.auth != null
                    && (
                      (resource.data.authorId == request.auth.uid
                       && isValidEvent(request.resource.data)
                       && authorAndTimeUnchanged()
                       // 마감 시각은 사후 변경 불가. 작성자가 마감된 이벤트의
                       // deadline을 미뤄 다시 열 수 있으면 경쟁형 행사에서 공정성이
                       // 깨진다(본문 열람 여부가 이 값으로 판정된다).
                       // 현재 클라이언트에는 이벤트 수정 UI 자체가 없다.
                       && request.resource.data.deadline == resource.data.deadline)
                      || isAdmin()
                    );

      allow delete: if request.auth != null
                    && (resource.data.authorId == request.auth.uid || isAdmin());

      // 본문: 마감 시각(부모 문서의 deadline) 이전에만 읽기 허용.
      // 서버 시계(request.time)로 판정하므로 클라이언트 시계 조작으로 우회 불가.
      // 작성자 본인과 관리자는 마감 후에도 관리 목적으로 열람 가능.
      // contentId를 'main'으로 못 박는다. 자유 ID였을 때는 본문 하위 문서 생성에
      // 쿼터가 걸리지 않아 이벤트 1건 아래에 문서를 무제한 만들 수 있었다.
      // 클라이언트도 항상 'main'만 쓴다(event.js).
      match /content/{contentId} {
        allow read: if request.time.toMillis() < eventDeadline(database, eventId)
                    || isAdmin()
                    || (request.auth != null && eventAuthorId(database, eventId) == request.auth.uid);
        allow create, update: if request.auth != null
                    && contentId == 'main'
                    && isValidEventContent(request.resource.data)
                    && isAllowedAttachment(request.resource.data)
                    && (eventAuthorId(database, eventId) == request.auth.uid || isAdmin());
        allow delete: if request.auth != null
                    && (eventAuthorId(database, eventId) == request.auth.uid || isAdmin());
      }

      match /comments/{commentId} {
        allow read: if true;
        // isFreshTimestamp를 isValidComment 안이 아니라 여기 top-level에 두는 이유는
        // 공지 create 규칙의 주석과 같다(underQuota와 중첩 평가 시의 이상 동작 회피).
        allow create: if request.auth != null
                      && isValidComment(request.resource.data)
                      && isAuthenticAuthor(request.resource.data)
                      && isFreshTimestamp(request.resource.data.timestamp)
                      && underQuota('commentCount', 10);
        // 수정은 본인만, 그것도 본문(content)만. 작성자 표기와 timestamp는 잠근다.
        // 관리자에게 주는 모더레이션 수단은 "삭제"이지 "남의 말 고쳐 쓰기"가 아니므로
        // update에서 isAdmin() 분기를 뺐다(현재 클라이언트에 댓글 수정 UI도 없다).
        allow update: if request.auth != null
                      && resource.data.authorId == request.auth.uid
                      && isValidComment(request.resource.data)
                      && authorAndTimeUnchanged();
        allow delete: if request.auth != null
                      && (resource.data.authorId == request.auth.uid || isAdmin());
      }

      match /likes/{likeId} {
        allow read: if true;
        allow create: if request.auth != null
                      && likeId == request.auth.uid
                      && isValidLike(request.resource.data, request.auth.uid);
        allow update, delete: if false;
      }
    }

    // 3. users
    // 읽기를 로그인 사용자로 제한한다. 예전에는 누구나(비로그인 포함) 전체 users
    // 컬렉션을 읽을 수 있어, 실명·소속 기수·경고 이력이 인터넷 어디서든 인증 없이
    // 노출됐다. 바로 아래 usernames 컬렉션은 애초에 request.auth != null로 막혀
    // 있었는데, 정작 더 많은 정보가 담긴 users는 열려 있던 비대칭이었다. 이 앱은
    // 미성년자를 포함할 수 있는 학생 커뮤니티이고 개인정보 처리방침에서도 실명 등을
    // 적법하게 보호하겠다고 명시하므로, 회원 목록(Members 화면)은 로그인해야만
    // 열람 가능하도록 좁힌다.
    match /users/{userId} {
      // 본인 문서 또는 관리자만. 예전에는 "로그인만 하면" 전 회원의 로그인 아이디·
      // 실명·기수·경고 이력을 통째로 읽을 수 있었는데, 가입 심사가 클라이언트에만
      // 있어서(onAuthStateChanged가 signOut을 부르는 방식) 구글 계정만 있으면 누구나
      // users/{uid}를 직접 만들어 정식 회원이 될 수 있다. 즉 "로그인한 사용자"라는
      // 조건은 사실상 아무나였다.
      //
      // 실제로 전체 명부가 필요한 화면은 관리자 콘솔뿐이고(admin.js는 관리자일 때만
      // 구독한다), 부원 목록은 공개 사본인 memberProfiles를 쓰므로 이렇게 좁혀도
      // 깨지는 화면이 없다.
      allow read: if request.auth != null
                  && (request.auth.uid == userId || isAdmin());

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && isValidUser(request.resource.data)
                    && request.resource.data.uid == userId
                    && request.resource.data.role == 'general';

      allow update: if request.auth != null
                    && (request.auth.uid == userId || isAdmin())
                    && isValidUserUpdate(resource.data, request.resource.data, isAdmin());

      allow delete: if request.auth != null
                    && (request.auth.uid == userId || isAdmin());

      // 부원 하트: users/{userId}/likes/{누른사람 uid}
      match /likes/{likeId} {
        allow read: if true;
        allow create: if request.auth != null
                      && likeId == request.auth.uid
                      && isValidLike(request.resource.data, request.auth.uid);
        allow update, delete: if false;
      }
    }

    // 5-b. memberProfiles: 부원 소개용 "공개" 프로필 (비로그인도 열람 가능)
    //
    // users/{uid}는 로그인해야 읽을 수 있다. 같은 문서 안에 경고 누적 횟수
    // (warnings, hasUnseenWarning)와 로그인 아이디(id) 같은 비공개 정보가 함께
    // 들어 있는데, Firestore 규칙은 "문서에서 일부 필드만 읽게" 하는 걸 지원하지
    // 않아 공개로 열면 그것들까지 통째로 노출되기 때문이다.
    //
    // 부원 소개(이름/기수/등급/설명)는 방문자에게도 보여주고 싶으므로, 공개해도
    // 되는 네 필드만 이 컬렉션에 따로 복제해 두고 여기만 공개로 연다.
    // 원본은 여전히 users 문서이고 이 컬렉션은 그 투영(projection)일 뿐이다.
    match /memberProfiles/{userId} {
      allow read: if true;

      // 미승인(general) 계정은 공개 프로필을 갖지 못한다.
      //
      // 부원 목록(members.js)은 admin/member/honored만 렌더링하므로, 가입만 하고 아직
      // 승인되지 않은 사람은 화면 어디에도 나타나지 않는다. 그런데 가입 시점에 공개
      // 프로필이 함께 만들어지고 있어서, SDK로 이 컬렉션을 통째로 읽으면 화면에 없는
      // 사람들의 실명·기수까지 전부 나왔다. 본인은 노출되고 있다는 사실조차 모르는
      // 상태였다 — 미성년자를 포함할 수 있는 학생 커뮤니티에서 동의 범위와 실제 노출
      // 범위가 어긋난 경우다.
      //
      // 승격 시점에 생성하고 강등 시점에 삭제하도록 클라이언트를 바꿨고, 여기서
      // 서버로도 강제한다.
      allow create, update: if request.auth != null
                    && (request.auth.uid == userId || isAdmin())
                    && isValidMemberProfile(request.resource.data, userId)
                    && request.resource.data.role != 'general';

      allow delete: if request.auth != null
                    && (request.auth.uid == userId || isAdmin());
    }

    match /faqs/{faqId} {
      allow read: if true;

      // FAQ 질문은 로그인한 사용자면 등급과 무관하게 작성 가능(화면 구성과 동일).
      // 다만 작성자 표기는 본인 users 문서와 대조한다.
      allow create: if request.auth != null
                    && isValidFaq(request.resource.data)
                    && isAuthenticAuthor(request.resource.data)
                    && isFreshTimestamp(request.resource.data.timestamp)
                    && underQuota('faqQuestionCount', 1);

      // 편집은 작성자 본인만, 삭제(모더레이션)는 부원·관리자도 가능.
      // 예전에는 update와 delete를 한 줄로 묶어 둬서, 부원 등급이면 누구나 남의 질문
      // 제목·본문·작성자 표기를 임의로 고쳐 쓸 수 있었다(실측 확인). 삭제 권한을
      // 주려던 의도가 편집 권한까지 함께 준 경우다.
      allow update: if request.auth != null
                    && resource.data.authorId == request.auth.uid
                    && isValidFaq(request.resource.data)
                    && authorAndTimeUnchanged();

      allow delete: if request.auth != null
                    && (resource.data.authorId == request.auth.uid || isModerator());

      match /answers/{answerId} {
        allow read: if true;

        // 답변은 부원/관리자만.
        allow create: if isModerator()
                      && isValidAnswer(request.resource.data)
                      && isAuthenticAuthor(request.resource.data)
                      && isFreshTimestamp(request.resource.data.timestamp);

        // 질문과 같은 이유로 편집은 본인만, 삭제는 모더레이터도 가능.
        allow update: if request.auth != null
                      && resource.data.authorId == request.auth.uid
                      && isValidAnswer(request.resource.data)
                      && authorAndTimeUnchanged();

        allow delete: if request.auth != null
                      && (resource.data.authorId == request.auth.uid || isModerator());
      }

      match /likes/{likeId} {
        allow read: if true;
        allow create: if request.auth != null
                      && likeId == request.auth.uid
                      && isValidLike(request.resource.data, request.auth.uid);
        allow update, delete: if false;
      }
    }

    // 4. traffic (사용자당 1문서. 날짜는 y/m/d 정수 필드로 들고 있다 — 아래 주석 참고)
    //
    // getAfter()로 본문 쓰기와 카운터 +1을 한 배치에 묶어 두었지만, 정작 카운터가 든
    // 이 문서 자체에 자유 쓰기·삭제가 열려 있어서 한도 전체가 두 번의 쓰기로
    // 무력화됐다(실측 확인). isValidTraffic()은 값의 "범위"만 볼 뿐 "이전 값보다
    // 작아지면 안 된다"는 조건이 없었기 때문에:
    //   (a) deleteDoc(traffic/{uid}) 후 다시 쓰기 → expectedCount()가 1을 돌려주므로 통과
    //   (b) 카운터를 0으로 덮어쓰기 → isTodayKst는 만족하면서 카운트만 리셋
    //   (c) 날짜를 어제로 되돌리기 → expectedCount()가 "오늘 기록 없음"으로 보고 1부터 시작
    // 공지 5건/일, 이벤트 5건/일, 댓글 10건/일, FAQ 1건/일이 전부 무의미해졌다.
    //
    // 그래서 "오늘자 문서에서 카운터가 줄어드는 방향"의 쓰기를 규칙에서 직접 막는다.
    // 날짜가 바뀐 경우의 리셋은 정상 동작이므로 그때만 감소를 허용한다.
    match /traffic/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
                   && request.auth.uid == uid
                   && isValidTraffic(request.resource.data)
                   && isTodayKst(request.resource.data);

      allow update: if request.auth != null
                   && request.auth.uid == uid
                   && isValidTraffic(request.resource.data)
                   // 쓰려는 문서는 반드시 "오늘" 날짜여야 한다((c) 차단)
                   && isTodayKst(request.resource.data)
                   && (
                        // 기존 문서가 지난 날짜면 통째 리셋이 정상이다
                        !isTodayKst(resource.data)
                        // 같은 날이면 어떤 카운터도 줄어들 수 없다((b) 차단)
                        || countersNotDecreasing()
                      );

      // 오늘자 카운터의 삭제만 막는다((a) 차단). 지난 날짜 문서는 어차피 리셋
      // 대상이라 지워도 이득이 없으므로, 탈퇴 시 개인정보 파기(purgeUserOwnedData)는
      // 그대로 동작한다 — 다만 "오늘 글을 쓴 당일에 탈퇴"하는 경우에만 문서가 남는다.
      // 그 잔여 문서에는 uid 키와 날짜·건수만 있고 실명 등 개인정보는 없다.
      allow delete: if request.auth != null
                   && request.auth.uid == uid
                   && !isTodayKst(resource.data);
    }

    // 5. usernames
    // 읽기를 로그인 사용자로 제한해 비로그인 상태에서 부원 실명을 열거하지 못하게 한다.
    match /usernames/{id} {
      allow read: if request.auth != null;

      // 문서 ID(= 로그인 아이디)와 요청자 사이에 아무 연결이 없어서, 계정 하나로
      // 로그인한 뒤 setDoc(usernames/'hong_gildong', ...)을 호출하면 남의 아이디를
      // 임의로 선점할 수 있었다. 선점당한 사람은 그 아이디로 가입이 막힌다
      // (resolveUniqueSignupProfile이 "이미 사용 중인 아이디"로 거부).
      //
      // 본인 users 문서의 id와 문서 ID가 일치할 것을 요구해 계정당 1개로 묶는다.
      // 가입 흐름이 users → usernames 순서로 쓰므로(auth.js) 이 시점에 users 문서는
      // 이미 존재한다. id는 isValidUserUpdate에서 변경 불가라 나중에 갈아탈 수도 없다.
      //
      // list(질의)는 계속 열어 둔다 — 가입 시 같은 기수·이름 중복 검사가
      // where('batch'==).where('name'==) 쿼리라서, 막으면 중복 검사가 깨진다.
      allow create: if request.auth != null
                    && isValidUsername(request.resource.data)
                    && request.resource.data.uid == request.auth.uid
                    && selfExists()
                    && userDoc(request.auth.uid).id == id;

      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && isValidUsername(request.resource.data);

      allow delete: if request.auth != null
                    && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // 6. serverTimeCheck: 클라이언트 시계 오차 측정용 (본인만 읽고 씀)
    // 스키마 검증이 전혀 없어 1MiB짜리 문서를 무제한 횟수로 써 넣을 수 있었다.
    // clock.js가 실제로 쓰는 것은 { t: serverTimestamp() } 하나뿐이므로 그 형태로
    // 못 박는다. serverTimestamp()는 규칙에서 request.time과 같은 값으로 평가되므로,
    // 임의의 시각이나 다른 필드를 실어 보내면 거부된다.
    match /serverTimeCheck/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['t'])
                   && request.resource.data.t == request.time;
    }
  }

  // ---------------------------------------------------------------------------
  // 신원/권한 판정
  //
  // 핵심 원칙: 문서에 담겨 오는 authorRole/authorName/authorBatch는 클라이언트가
  // 만든 값이므로 신뢰하지 않는다. 반드시 요청자 본인의 users 문서와 대조한다.
  // 이 대조가 없으면 아무 계정이나 authorRole:'admin', authorName:'<타인 이름>'
  // 으로 글을 올려 관리자/타 부원을 사칭할 수 있다.
  // ---------------------------------------------------------------------------

  function selfDoc() {
    return get(/databases/(default)/documents/users/$(request.auth.uid)).data;
  }

  function selfExists() {
    return request.auth != null
           && exists(/databases/(default)/documents/users/$(request.auth.uid));
  }

  function selfRole() {
    return selfExists() ? selfDoc().role : 'none';
  }

  function isAdmin() {
    return selfRole() == 'admin';
  }

  // 부원 + 관리자 (FAQ 답변/모더레이션 권한)
  function isModerator() {
    return selfRole() in ['member', 'admin'];
  }

  // 공지/이벤트 작성 권한: 관리자·부원·명예부원만.
  // (가입만 하고 아직 승인되지 않은 'general' 등급은 글을 쓸 수 없다)
  function canPostNotice() {
    return selfRole() in ['admin', 'member', 'honored'];
  }

  // 수정(update) 시 작성자 표기와 작성 시각은 절대 바뀌면 안 된다.
  //
  // create에는 isAuthenticAuthor()로 사칭을 막아 두었는데 update 경로에는 아무 검증도
  // 없었다. 소유권 검사가 보는 것은 resource.data(수정 "전" 문서)뿐이라, 정상 댓글을
  // 하나 단 뒤 곧바로 authorName/authorRole만 갈아끼우면 "42기 홍길동 (관리자)"로
  // 표시되는 댓글을 누구나 만들 수 있었다(에뮬레이터로 실측 확인). authorId까지 타인
  // uid로 바꾸면 그 사람에게 삭제 권한이 넘어가 책임 전가까지 성립했다.
  //
  // timestamp도 같이 잠근다. 정렬(orderBy timestamp)에 쓰이므로 수정 시 미래값으로
  // 바꾸면 목록 최상단을 영구 점유할 수 있다 — create에서 isFreshTimestamp로 막아 둔
  // 것을 update가 그대로 되돌리는 셈이었다.
  function authorAndTimeUnchanged() {
    return request.resource.data.authorId == resource.data.authorId
           && request.resource.data.authorName == resource.data.authorName
           && request.resource.data.authorBatch == resource.data.authorBatch
           && request.resource.data.authorRole == resource.data.authorRole
           && request.resource.data.timestamp == resource.data.timestamp;
  }

  // 작성자 표기가 실제 계정 정보와 일치하는지 대조한다.
  function isAuthenticAuthor(data) {
    return selfExists()
           && data.authorId == request.auth.uid
           && data.authorName == selfDoc().name
           && data.authorBatch == selfDoc().batch
           && data.authorRole == selfDoc().role;
  }

  // 첨부파일 정책: 명예부원은 첨부 불가(클라이언트 UI뿐 아니라 서버에서도 차단),
  // 파일 개수를 제한하고, 파일당 바이트 크기도 서버에서 직접 검증한다.
  //
  // 예전에는 업로드 용량 체크가 클라이언트(traffic.js의 일일 2MB 예산)에만 있었고,
  // 그마저 관리자 계정은 건너뛰었다. 규칙은 files가 list인지, 개수가 10개 이하인지만
  // 봤을 뿐 각 파일의 fileData(base64) 실제 길이는 전혀 검증하지 않았다. 즉 UI를
  // 거치지 않고 Firestore SDK를 직접 호출하면(또는 관리자 계정이면) 바이트 제한이
  // 사실상 없었다.
  //
  // Firestore 문서 자체가 1MiB로 하드캡되어 있어 "수백 GB짜리 업로드"는 애초에
  // 불가능하지만(에뮬레이터로 실측: 2MB 첨부부터 INVALID_ARGUMENT로 거부됨), 900KB에
  // 가까운 파일을 반복해서 채워 넣는 방식으로 무료 티어의 저장 용량(총 1GiB)을
  // 서서히 소진시킬 수 있었다. 파일당 700KB로 제한해 이 경로를 막는다.
  //
  // 파일별 상한과 별개로 "첨부 합계"까지 규칙에서 직접 더해 검증하는 버전도
  // 시도했으나, getAfter() 기반 일일 한도 검사(underQuota)와 같은 배치에 있을 때
  // 에뮬레이터에서 재현 가능한 이상 동작(각 함수는 단독으로는 정상 동작하는데
  // 함께 쓰면 통과되어 버림)이 나와 제외했다. 파일 개수(≤10) × 파일당 상한만으로도
  // 결국 Firestore의 문서당 1MiB 하드캡에 걸리므로, 합계를 직접 검사하지 않아도
  // "수백 GB" 같은 극단적 크기는 여전히 막힌다.
  function isAllowedAttachment(data) {
    return !('files' in data)
           || (data.files is list
               && data.files.size() <= 10
               && (data.files.size() == 0 || selfRole() != 'honored')
               && filesWithinPerFileLimit(data.files, 700000));
  }

  // 파일 1개에 대한 검증(크기 + 이름 + MIME).
  //
  // [이름] 서버에서 전혀 검증하지 않아 확장자 위장이나 U+202E(RTL override) 삽입이
  // 가능했다. RTL override는 파일명 표시 순서를 뒤집어 "보고서exe.txt"를
  // "보고서txt.exe"처럼 보이게 만드는 고전적인 수법이다. 경로 구분자도 막는다.
  //
  // [MIME] data: 스킴 형식만 보고 MIME은 무제한이라, data:text/html 을
  // "보고서.html"로 내려받게 만들 수 있었다. 사용자가 그 파일을 열면 로컬
  // 컨텍스트에서 스크립트가 실행된다. 다만 이 사이트는 학술 자료(hwp/pptx/zip 등)를
  // 주고받는 용도이므로 허용 목록 방식은 정상 사용을 깨뜨린다. 그래서 브라우저가
  // 능동 콘텐츠로 렌더링하는 타입만 골라 차단한다.
  function fileEntryOk(f, maxBytes) {
    return f.fileData is string
           && f.fileData.size() <= maxBytes
           && !f.fileData.matches('(?i)^data:\\s*(text/html|image/svg\\+xml|application/xhtml\\+xml|text/xml|application/xml|text/javascript|application/javascript)\\s*[;,].*')
           && f.fileName is string
           && f.fileName.size() > 0
           && f.fileName.size() <= 200
           && !f.fileName.matches('.*[/\\\\\\x{202a}-\\x{202e}\\x{2066}-\\x{2069}\\x{0000}-\\x{001f}].*');
  }

  // Firestore 규칙 언어에는 리스트에 대한 map/reduce가 없어, 최대 개수(10)만큼
  // 인덱스를 직접 펼쳐 쓴다. size()가 그보다 작은 인덱스는 존재 자체를 먼저
  // 확인(단락 평가)해 인덱스 초과 오류 없이 안전하게 스킵한다.
  function filesWithinPerFileLimit(files, maxBytes) {
    return (files.size() < 1  || fileEntryOk(files[0], maxBytes))
        && (files.size() < 2  || fileEntryOk(files[1], maxBytes))
        && (files.size() < 3  || fileEntryOk(files[2], maxBytes))
        && (files.size() < 4  || fileEntryOk(files[3], maxBytes))
        && (files.size() < 5  || fileEntryOk(files[4], maxBytes))
        && (files.size() < 6  || fileEntryOk(files[5], maxBytes))
        && (files.size() < 7  || fileEntryOk(files[6], maxBytes))
        && (files.size() < 8  || fileEntryOk(files[7], maxBytes))
        && (files.size() < 9  || fileEntryOk(files[8], maxBytes))
        && (files.size() < 10 || fileEntryOk(files[9], maxBytes));
  }

  // content/files는 필수가 아니라 "있으면 검증"으로 둔다. 새로 쓰는 카드는 이
  // 필드들을 아예 안 담고(본문은 notices/{id}/content/main으로 분리), 반면 이미
  // 만들어진 옛 공지는 카드 안에 이 필드들이 그대로 들어 있다 — 이관 스크립트를
  // 돌릴 방법이 없어(운영 Firestore 직접 쓰기 권한 없음) 그 문서들을 강제로
  // "없어야 한다"로 두면, 고정(pinned) 토글처럼 문서 전체를 다시 검증하는 흔한
  // update 한 번에도 옛 공지가 전부 거부되어 버린다.
  function isValidNotice(data) {
    return data is map
           && data.title is string
           && data.title.size() > 0
           && data.title.size() <= 100
           && (!('content' in data) || (data.content is string && data.content.size() <= 2000))
           && data.authorId is string
           && data.authorName is string
           && data.date is string
           && data.timestamp is int
           && (!('tag' in data) || data.tag in ['학술 자료', '이벤트 안내', '설문 조사', '활동 기록', '기타'])
           && (!('files' in data) || data.files is list)
           && (!('hasFiles' in data) || data.hasFiles is bool)
           && (!('pinned' in data) || data.pinned is bool);
  }

  function isValidNoticeContent(data) {
    return data is map
           && data.content is string
           && data.content.size() <= 2000
           && (!('files' in data) || data.files is list);
  }

  // hasOnly로 스키마를 못 박는 이유: 정의하지 않은 필드가 애초에 들어오지 못하게
  // 하는 것이 근본 대책이다. 이게 없으면 댓글에 files 배열을 끼워 넣어 첨부 정책
  // (파일당 700KB·최대 10개·명예부원 금지)을 통째로 우회할 수 있었다 — 댓글에는
  // isAllowedAttachment가 create에도 걸려 있지 않기 때문이다.
  // 필드 목록은 실제 클라이언트가 쓰는 것과 동일하다(notice.js/event.js의 댓글 생성).
  function isValidComment(data) {
    return data is map
           && data.keys().hasOnly(['content', 'authorId', 'authorName', 'authorBatch', 'authorRole', 'date', 'timestamp'])
           && data.keys().hasAll(['content', 'authorId', 'authorName', 'authorBatch', 'authorRole', 'date', 'timestamp'])
           && data.content is string
           && data.content.size() > 0
           && data.content.size() <= 500
           && data.authorId is string
           && data.authorName is string
           && data.date is string
           && data.timestamp is int;
  }

  function isValidFaq(data) {
    return data is map
           && data.keys().hasOnly(['title', 'content', 'authorId', 'authorName', 'authorBatch', 'authorRole', 'date', 'timestamp'])
           && data.keys().hasAll(['title', 'content', 'authorId', 'authorName', 'authorBatch', 'authorRole', 'date', 'timestamp'])
           && data.title is string
           && data.title.size() > 0
           && data.title.size() <= 50
           && data.content is string
           && data.content.size() <= 3000
           && data.authorId is string
           && data.authorName is string
           && data.date is string
           && data.timestamp is int;
  }

  function isValidAnswer(data) {
    return data is map
           && data.keys().hasOnly(['content', 'authorId', 'authorName', 'authorBatch', 'authorRole', 'date', 'timestamp'])
           && data.keys().hasAll(['content', 'authorId', 'authorName', 'authorBatch', 'authorRole', 'date', 'timestamp'])
           && data.content is string
           && data.content.size() > 0
           && data.content.size() <= 1000
           && data.authorId is string
           && data.authorName is string
           && data.date is string
           && data.timestamp is int;
  }

  // 이벤트 목록 카드. deadline은 마감 시각(밀리초). timestamp는 서버시각과 20분 이내여야 함.
  function isValidEvent(data) {
    return data is map
           && data.title is string
           && data.title.size() > 0
           && data.title.size() <= 100
           && data.authorId is string
           && data.authorName is string
           && data.date is string
           && data.timestamp is int
           && data.deadline is int
           && isFreshTimestamp(data.timestamp)
           // 이벤트 "카드"는 첨부를 갖지 않는 구조다. 첨부는 항상 본문 문서
           // (events/{id}/content/main)에 들어가고 그쪽에는 isAllowedAttachment가
           // 걸려 있다. 그런데 카드의 update 경로에는 isAllowedAttachment가 빠져
           // 있어서, 작성자가 카드를 수정하면서 700KB 상한·개수 제한·명예부원 첨부
           // 금지를 모두 우회한 files 배열을 심을 수 있었다(실측 확인). 클라이언트는
           // 카드의 files를 읽지 않지만 데이터는 남아 목록 구독 시 전 방문자에게
           // 전송된다. 카드에서는 files를 아예 금지하는 편이 정확하다.
           && !('files' in data);
  }

  function isValidEventContent(data) {
    return data is map
           && data.content is string
           && data.content.size() <= 2000
           && (!('files' in data) || data.files is list);
  }

  function isValidLike(data, uid) {
    return data is map
           && data.keys().hasOnly(['uid', 'timestamp'])
           && data.uid == uid
           && data.timestamp is int;
  }

  // 표시 이름에 쓸 수 있는 문자. auth.js의 클라이언트 검증과 같은 집합이다.
  // 길이만 보던 예전 규칙에서는 SDK를 직접 호출해 제로폭 문자나 동형이의 문자를
  // 섞은 이름을 만들 수 있었고, 그러면 부원 목록에서 다른 사람과 시각적으로
  // 구분되지 않는 계정이 만들어진다(렌더링이 textContent라 XSS는 아니지만 사칭 소지).
  function isValidDisplayName(name) {
    return name.matches('^[0-9A-Za-z가-힣ㄱ-ㅎㅏ-ㅣ ]{3,10}$');
  }

  function isValidUser(data) {
    return data is map
           && data.uid is string
           && data.uid == request.auth.uid
           && data.id is string
           && (data.id.matches('^[A-Za-z0-9_]{4,20}$') || data.id == request.auth.uid)
           && data.batch is string
           && (data.batch == '' || data.batch.matches('^[0-9][0-9].$'))
           && data.name is string
           && isValidDisplayName(data.name)
           && data.role == 'general'
           && (!('warnings' in data) || data.warnings == 0)
           && (!('email' in data))
           && (!('pwHash' in data))
           && (!('pw' in data));
  }

  // 본인 수정으로 바꿀 수 있는 것은 description과 (경고 확인 처리용)
  // hasUnseenWarning: false 뿐이다.
  //  - name을 잠그지 않으면 가입 후 이름만 바꿔 다른 부원을 사칭할 수 있다.
  //  - warnings/role은 관리자만 조정할 수 있다.
  function isValidUserUpdate(oldData, newData, isAdminActor) {
    return newData is map
           && newData.uid == oldData.uid
           && (newData.uid == request.auth.uid || isAdminActor)
           && newData.id == oldData.id
           && newData.batch == oldData.batch
           && newData.name is string
           && isValidDisplayName(newData.name)
           && (isAdminActor || newData.name == oldData.name)
           && (isAdminActor || newData.role == oldData.role)
           // .get()으로 읽는 이유: 가입 시 setDoc은 warnings 필드를 만들지 않으므로
           // 경고를 한 번도 받지 않은 계정에는 이 필드가 아예 없다. 예전처럼
           // newData.warnings로 직접 접근하면 "Property warnings is undefined on
           // object" 평가 오류가 나면서 규칙이 거부로 떨어져, 그런 계정은 본인
           // 소개글(description)을 저장할 수 없었다(실측 확인). 바로 아래
           // hasUnseenWarning은 이미 .get()으로 안전하게 처리돼 있었는데 여기만 빠져
           // 있었다. 필드가 없으면 0으로 보고 비교한다.
           && (isAdminActor || newData.get('warnings', 0) == oldData.get('warnings', 0))
           && (isAdminActor
               || !newData.get('hasUnseenWarning', false)
               || oldData.get('hasUnseenWarning', false))
           && (!('description' in newData)
               || (newData.description is string && newData.description.size() <= 2000))
           && (!('pwHash' in newData))
           && (!('pw' in newData));
  }

  function isValidTraffic(data) {
    return data is map
           && data.keys().hasOnly(['y', 'm', 'd', 'noticeCount', 'eventCount', 'uploadBytes', 'downloadBytes', 'commentCount', 'faqQuestionCount'])
           && data.y is int && data.m is int && data.d is int
           && (!('noticeCount' in data) || (data.noticeCount is int && data.noticeCount >= 0 && data.noticeCount <= 1000))
           && (!('eventCount' in data) || (data.eventCount is int && data.eventCount >= 0 && data.eventCount <= 1000))
           && (!('uploadBytes' in data) || (data.uploadBytes is int && data.uploadBytes >= 0 && data.uploadBytes <= 1073741824))
           && (!('downloadBytes' in data) || (data.downloadBytes is int && data.downloadBytes >= 0 && data.downloadBytes <= 1073741824))
           && (!('commentCount' in data) || (data.commentCount is int && data.commentCount >= 0 && data.commentCount <= 1000))
           && (!('faqQuestionCount' in data) || (data.faqQuestionCount is int && data.faqQuestionCount >= 0 && data.faqQuestionCount <= 1000));
  }

  function userDoc(userId) {
    return get(/databases/(default)/documents/users/$(userId)).data;
  }

  // 공개 프로필은 users 문서의 투영이므로 담을 수 있는 필드를 네 개로 못 박고,
  // 이름·기수·등급은 반드시 원본 users 문서의 값과 같아야 한다.
  // 이 대조가 없으면 누구나 자기 공개 프로필의 role만 'admin'으로 적어 부원
  // 목록에서 관리자로 행세할 수 있다(목록이 이 값을 그대로 렌더링하므로).
  function isValidMemberProfile(data, userId) {
    return data is map
           && data.keys().hasOnly(['uid', 'name', 'batch', 'role', 'description'])
           && data.keys().hasAll(['uid', 'name', 'batch', 'role'])
           && data.uid == userId
           && exists(/databases/(default)/documents/users/$(userId))
           && data.name == userDoc(userId).name
           && data.batch == userDoc(userId).batch
           && data.role == userDoc(userId).role
           && (!('description' in data)
               || (data.description is string && data.description.size() <= 2000));
  }

  function isValidUsername(data) {
    return data is map
           && data.uid is string
           && data.uid == request.auth.uid
           && data.batch is string
           && (data.batch == '' || data.batch.matches('^[0-9][0-9].$'))
           && data.name is string
           && isValidDisplayName(data.name);
  }

  // ---------------------------------------------------------------------------
  // 일일 한도 강제
  //
  // 예전에는 카운터 증가가 본문 쓰기와 별개의 요청이라, 클라이언트가 그냥
  // 증가를 호출하지 않으면 한도가 무의미했다(규칙이 traffic을 보지 않았음).
  //
  // getAfter()는 배치/트랜잭션이 커밋된 "후"의 상태를 보여준다. 이를 이용해
  // 본문 생성을 "같은 배치 안에서 카운터가 정확히 +1 되었을 것"에 묶으면,
  // 카운터를 빼먹은 단독 쓰기는 서버가 거부한다.
  //
  // 날짜를 문자열 대신 y/m/d 정수로 두는 이유: 규칙에는 zero-padding이 없어
  // 'YYYY-MM-DD' 문자열을 만들 수 없다. request.time은 UTC이므로 KST(+9h)로 옮겨
  // 비교하며, 지난 날짜의 카운터를 그대로 들고 오는 리셋 우회도 막힌다.
  // ---------------------------------------------------------------------------

  function trafficRef() {
    return /databases/(default)/documents/traffic/$(request.auth.uid);
  }

  function kstNow() {
    return request.time + duration.value(9, 'h');
  }

  function isTodayKst(d) {
    return d.get('y', 0) == kstNow().year()
           && d.get('m', 0) == kstNow().month()
           && d.get('d', 0) == kstNow().day();
  }

  // 커밋 후 카운터가 "오늘 날짜"로 정확히 +1 되었고 한도 이내인가?
  function quotaSpent(field, limit) {
    return isTodayKst(getAfter(trafficRef()).data)
           && getAfter(trafficRef()).data.get(field, -1) == expectedCount(field)
           && getAfter(trafficRef()).data.get(field, -1) <= limit;
  }

  // 오늘 첫 사용이면 1, 이미 오늘 기록이 있으면 직전 값 + 1.
  function expectedCount(field) {
    return (exists(trafficRef()) && isTodayKst(get(trafficRef()).data))
           ? get(trafficRef()).data.get(field, 0) + 1
           : 1;
  }

  // 관리자는 기존 동작대로 한도에서 제외된다.
  function underQuota(field, limit) {
    return isAdmin() || quotaSpent(field, limit);
  }

  // 오늘자 문서를 덮어쓸 때 어떤 카운터도 감소하지 않아야 한다.
  // 필드가 없던 경우(0)에서 늘어나는 것은 정상이므로 .get(f, 0)으로 비교한다.
  function counterNotDecreasing(f) {
    return request.resource.data.get(f, 0) >= resource.data.get(f, 0);
  }

  function countersNotDecreasing() {
    return counterNotDecreasing('noticeCount')
           && counterNotDecreasing('eventCount')
           && counterNotDecreasing('commentCount')
           && counterNotDecreasing('faqQuestionCount')
           && counterNotDecreasing('uploadBytes')
           && counterNotDecreasing('downloadBytes');
  }

  // 클라이언트가 보낸 timestamp가 서버시각과 20분(1,200,000ms) 이내인지.
  // 컴퓨터 시계를 크게 조작한 상태의 쓰기를 서버가 거부한다.
  function isFreshTimestamp(ts) {
    return ts is int
           && request.time.toMillis() - ts <= 1200000
           && ts - request.time.toMillis() <= 1200000;
  }

  // 이벤트 본문 규칙에서 부모 이벤트 문서의 값을 읽어온다.
  function eventDeadline(database, eventId) {
    return get(/databases/$(database)/documents/events/$(eventId)).data.deadline;
  }

  function eventAuthorId(database, eventId) {
    return get(/databases/$(database)/documents/events/$(eventId)).data.authorId;
  }

  // 공지 본문 규칙에서 부모 공지 카드의 작성자를 읽어온다.
  function noticeAuthorId(database, noticeId) {
    return get(/databases/$(database)/documents/notices/$(noticeId)).data.authorId;
  }
}
