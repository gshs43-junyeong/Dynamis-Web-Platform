rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // collectionGroup('comments') 지원.
    // 회원 탈퇴 시 본인이 작성한 댓글을 공지/이벤트 전반에서 한 번에 조회하려면
    // 재귀 와일드카드 경로 규칙이 있어야 그룹 쿼리가 허용된다.
    // (개별 문서 접근은 각 부모 밑의 구체 규칙이 그대로 적용되고, 여기서는 조회만 연다)
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

    // 1. notices
    match /notices/{noticeId} {
      allow read: if true;

      // 작성 권한은 서버가 users 문서의 실제 role로 판정한다.
      // 클라이언트가 보낸 authorRole/authorName/authorBatch는 신뢰하지 않고
      // 요청자 본인의 users 문서와 일치하는지 대조한다(작성자·등급 사칭 차단).
      //
      // pinned: "고정"은 관리자 전용 기능(togglePin())이지만, 클라이언트가 항상
      // pinned:false로 생성해 왔을 뿐 규칙에는 이를 강제하는 조건이 없었다. 즉
      // 일반 부원도 addDoc 시 pinned:true를 직접 실어 보내면 자기 글을 최상단에
      // 셀프 고정할 수 있었다(에뮬레이터로 실측 확인). 생성 시 관리자가 아니면
      // pinned는 반드시 false여야 한다.
      //
      // isFreshTimestamp: isValidEvent에는 있었는데 이쪽엔 빠져 있었다 — timestamp를
      // 미래값(예: 9999999999999)으로 보내면 정렬(displayNoticesGlobal의 timestamp
      // desc)상 항상 최상단에 노출되어 고정 글보다도 위에 뜰 수 있었다.
      // isValidNotice() 안에 넣지 않고 여기 top-level 조건으로 둔 이유: isValidNotice
      // 내부에 중첩해서 underQuota()와 함께 평가하면 에뮬레이터에서 재현되는 이상
      // 동작(요청이 잘못된 timestamp로도 조용히 통과됨)이 있었다. 동일 함수를
      // top-level로 옮기니 문제없이 동작해, 원인 규명 없이 안전하게 검증된 이 형태로 둔다.
      allow create: if canPostNotice()
                    && isValidNotice(request.resource.data)
                    && isAuthenticAuthor(request.resource.data)
                    && isAllowedAttachment(request.resource.data)
                    && (isAdmin() || request.resource.data.get('pinned', false) == false)
                    && isFreshTimestamp(request.resource.data.timestamp)
                    && underQuota('noticeCount', 5);

      allow update: if request.auth != null
                    && (
                      (resource.data.authorId == request.auth.uid
                       && isValidNotice(request.resource.data)
                       && isAllowedAttachment(request.resource.data)
                       && request.resource.data.authorId == resource.data.authorId
                       && request.resource.data.authorName == resource.data.authorName
                       && request.resource.data.authorBatch == resource.data.authorBatch
                       && request.resource.data.authorRole == resource.data.authorRole
                       // pinned 변경도 관리자 전용: 본인 수정 경로에서는 값을 그대로 유지해야 한다
                       // (마찬가지로 실측 확인된 셀프 고정 우회 — update 경로도 동일하게 막는다).
                       && request.resource.data.get('pinned', false) == resource.data.get('pinned', false))
                      || isAdmin()
                    );

      allow delete: if request.auth != null
                    && (resource.data.authorId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
                      && isValidComment(request.resource.data)
                      && isAuthenticAuthor(request.resource.data)
                      && underQuota('commentCount', 10);
        allow update, delete: if request.auth != null
                              && (resource.data.authorId == request.auth.uid || isAdmin());
      }

      // 한 계정당 하트 1회, 취소 불가 (docId == 누른 사람 uid)
      match /likes/{likeId} {
        allow read: if true;
        allow create: if request.auth != null
                      && likeId == request.auth.uid
                      && isValidLike(request.resource.data, request.auth.uid);
        allow update, delete: if false;
      }
    }

    // 2. events (notice와 동일한 구조 + 마감 타이머)
    //    - 목록 카드(events/{eventId})는 항상 읽기 가능 (제목/작성자/마감시각)
    //    - 본문(events/{eventId}/content/main)은 마감 전에만 서버가 열어줌
    match /events/{eventId} {
      allow read: if true;

      allow create: if canPostNotice()
                    && isValidEvent(request.resource.data)
                    && isAuthenticAuthor(request.resource.data)
                    && underQuota('eventCount', 5);

      allow update: if request.auth != null
                    && (
                      (resource.data.authorId == request.auth.uid
                       && isValidEvent(request.resource.data)
                       && request.resource.data.authorId == resource.data.authorId
                       && request.resource.data.authorName == resource.data.authorName
                       && request.resource.data.authorBatch == resource.data.authorBatch
                       && request.resource.data.authorRole == resource.data.authorRole)
                      || isAdmin()
                    );

      allow delete: if request.auth != null
                    && (resource.data.authorId == request.auth.uid || isAdmin());

      // 본문: 마감 시각(부모 문서의 deadline) 이전에만 읽기 허용.
      // 서버 시계(request.time)로 판정하므로 클라이언트 시계 조작으로 우회 불가.
      // 작성자 본인과 관리자는 마감 후에도 관리 목적으로 열람 가능.
      match /content/{contentId} {
        allow read: if request.time.toMillis() < eventDeadline(database, eventId)
                    || isAdmin()
                    || (request.auth != null && eventAuthorId(database, eventId) == request.auth.uid);
        allow create, update: if request.auth != null
                    && isValidEventContent(request.resource.data)
                    && isAllowedAttachment(request.resource.data)
                    && (eventAuthorId(database, eventId) == request.auth.uid || isAdmin());
        allow delete: if request.auth != null
                    && (eventAuthorId(database, eventId) == request.auth.uid || isAdmin());
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
                      && isValidComment(request.resource.data)
                      && isAuthenticAuthor(request.resource.data)
                      && underQuota('commentCount', 10);
        allow update, delete: if request.auth != null
                              && (resource.data.authorId == request.auth.uid || isAdmin());
      }

      match /likes/{likeId} {
        allow read: if true;
        allow create: if request.auth != null
                      && likeId == request.auth.uid
                      && isValidLike(request.resource.data, request.auth.uid);
        allow update, delete: if false;
      }
    }

    // 3. users
    // 읽기를 로그인 사용자로 제한한다. 예전에는 누구나(비로그인 포함) 전체 users
    // 컬렉션을 읽을 수 있어, 실명·소속 기수·경고 이력이 인터넷 어디서든 인증 없이
    // 노출됐다. 바로 아래 usernames 컬렉션은 애초에 request.auth != null로 막혀
    // 있었는데, 정작 더 많은 정보가 담긴 users는 열려 있던 비대칭이었다. 이 앱은
    // 미성년자를 포함할 수 있는 학생 커뮤니티이고 개인정보 처리방침에서도 실명 등을
    // 적법하게 보호하겠다고 명시하므로, 회원 목록(Members 화면)은 로그인해야만
    // 열람 가능하도록 좁힌다.
    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && isValidUser(request.resource.data)
                    && request.resource.data.uid == userId
                    && request.resource.data.role == 'general';

      allow update: if request.auth != null
                    && (request.auth.uid == userId || isAdmin())
                    && isValidUserUpdate(resource.data, request.resource.data, isAdmin());

      allow delete: if request.auth != null
                    && (request.auth.uid == userId || isAdmin());

      // 부원 하트: users/{userId}/likes/{누른사람 uid}
      match /likes/{likeId} {
        allow read: if true;
        allow create: if request.auth != null
                      && likeId == request.auth.uid
                      && isValidLike(request.resource.data, request.auth.uid);
        allow update, delete: if false;
      }
    }

    match /faqs/{faqId} {
      allow read: if true;

      // FAQ 질문은 로그인한 사용자면 등급과 무관하게 작성 가능(화면 구성과 동일).
      // 다만 작성자 표기는 본인 users 문서와 대조한다.
      allow create: if request.auth != null
                    && isValidFaq(request.resource.data)
                    && isAuthenticAuthor(request.resource.data)
                    && underQuota('faqQuestionCount', 1);

      allow update, delete: if request.auth != null
                              && (resource.data.authorId == request.auth.uid || isModerator());

      match /answers/{answerId} {
        allow read: if true;

        // 답변은 부원/관리자만.
        allow create: if isModerator()
                      && isValidAnswer(request.resource.data)
                      && isAuthenticAuthor(request.resource.data);

        allow update, delete: if request.auth != null
                              && (resource.data.authorId == request.auth.uid || isModerator());
      }

      match /likes/{likeId} {
        allow read: if true;
        allow create: if request.auth != null
                      && likeId == request.auth.uid
                      && isValidLike(request.resource.data, request.auth.uid);
        allow update, delete: if false;
      }
    }

    // 4. traffic (사용자당 1문서. 날짜는 y/m/d 정수 필드로 들고 있다 — 아래 주석 참고)
    match /traffic/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
                   && request.auth.uid == uid
                   && isValidTraffic(request.resource.data);

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 5. usernames
    // 읽기를 로그인 사용자로 제한해 비로그인 상태에서 부원 실명을 열거하지 못하게 한다.
    match /usernames/{id} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && isValidUsername(request.resource.data);

      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && isValidUsername(request.resource.data);

      allow delete: if request.auth != null
                    && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // 6. serverTimeCheck: 클라이언트 시계 오차 측정용 (본인만 읽고 씀)
    match /serverTimeCheck/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }

  // ---------------------------------------------------------------------------
  // 신원/권한 판정
  //
  // 핵심 원칙: 문서에 담겨 오는 authorRole/authorName/authorBatch는 클라이언트가
  // 만든 값이므로 신뢰하지 않는다. 반드시 요청자 본인의 users 문서와 대조한다.
  // 이 대조가 없으면 아무 계정이나 authorRole:'admin', authorName:'<타인 이름>'
  // 으로 글을 올려 관리자/타 부원을 사칭할 수 있다.
  // ---------------------------------------------------------------------------

  function selfDoc() {
    return get(/databases/(default)/documents/users/$(request.auth.uid)).data;
  }

  function selfExists() {
    return request.auth != null
           && exists(/databases/(default)/documents/users/$(request.auth.uid));
  }

  function selfRole() {
    return selfExists() ? selfDoc().role : 'none';
  }

  function isAdmin() {
    return selfRole() == 'admin';
  }

  // 부원 + 관리자 (FAQ 답변/모더레이션 권한)
  function isModerator() {
    return selfRole() in ['member', 'admin'];
  }

  // 공지/이벤트 작성 권한: 관리자·부원·명예부원만.
  // (가입만 하고 아직 승인되지 않은 'general' 등급은 글을 쓸 수 없다)
  function canPostNotice() {
    return selfRole() in ['admin', 'member', 'honored'];
  }

  // 작성자 표기가 실제 계정 정보와 일치하는지 대조한다.
  function isAuthenticAuthor(data) {
    return selfExists()
           && data.authorId == request.auth.uid
           && data.authorName == selfDoc().name
           && data.authorBatch == selfDoc().batch
           && data.authorRole == selfDoc().role;
  }

  // 첨부파일 정책: 명예부원은 첨부 불가(클라이언트 UI뿐 아니라 서버에서도 차단),
  // 파일 개수를 제한하고, 파일당 바이트 크기도 서버에서 직접 검증한다.
  //
  // 예전에는 업로드 용량 체크가 클라이언트(traffic.js의 일일 2MB 예산)에만 있었고,
  // 그마저 관리자 계정은 건너뛰었다. 규칙은 files가 list인지, 개수가 10개 이하인지만
  // 봤을 뿐 각 파일의 fileData(base64) 실제 길이는 전혀 검증하지 않았다. 즉 UI를
  // 거치지 않고 Firestore SDK를 직접 호출하면(또는 관리자 계정이면) 바이트 제한이
  // 사실상 없었다.
  //
  // Firestore 문서 자체가 1MiB로 하드캡되어 있어 "수백 GB짜리 업로드"는 애초에
  // 불가능하지만(에뮬레이터로 실측: 2MB 첨부부터 INVALID_ARGUMENT로 거부됨), 900KB에
  // 가까운 파일을 반복해서 채워 넣는 방식으로 무료 티어의 저장 용량(총 1GiB)을
  // 서서히 소진시킬 수 있었다. 파일당 700KB로 제한해 이 경로를 막는다.
  //
  // 파일별 상한과 별개로 "첨부 합계"까지 규칙에서 직접 더해 검증하는 버전도
  // 시도했으나, getAfter() 기반 일일 한도 검사(underQuota)와 같은 배치에 있을 때
  // 에뮬레이터에서 재현 가능한 이상 동작(각 함수는 단독으로는 정상 동작하는데
  // 함께 쓰면 통과되어 버림)이 나와 제외했다. 파일 개수(≤10) × 파일당 상한만으로도
  // 결국 Firestore의 문서당 1MiB 하드캡에 걸리므로, 합계를 직접 검사하지 않아도
  // "수백 GB" 같은 극단적 크기는 여전히 막힌다.
  function isAllowedAttachment(data) {
    return !('files' in data)
           || (data.files is list
               && data.files.size() <= 10
               && (data.files.size() == 0 || selfRole() != 'honored')
               && filesWithinPerFileLimit(data.files, 700000));
  }

  // Firestore 규칙 언어에는 리스트에 대한 map/reduce가 없어, 최대 개수(10)만큼
  // 인덱스를 직접 펼쳐 쓴다. size()가 그보다 작은 인덱스는 존재 자체를 먼저
  // 확인(단락 평가)해 인덱스 초과 오류 없이 안전하게 스킵한다.
  function filesWithinPerFileLimit(files, maxBytes) {
    return (files.size() < 1  || files[0].fileData.size() <= maxBytes)
        && (files.size() < 2  || files[1].fileData.size() <= maxBytes)
        && (files.size() < 3  || files[2].fileData.size() <= maxBytes)
        && (files.size() < 4  || files[3].fileData.size() <= maxBytes)
        && (files.size() < 5  || files[4].fileData.size() <= maxBytes)
        && (files.size() < 6  || files[5].fileData.size() <= maxBytes)
        && (files.size() < 7  || files[6].fileData.size() <= maxBytes)
        && (files.size() < 8  || files[7].fileData.size() <= maxBytes)
        && (files.size() < 9  || files[8].fileData.size() <= maxBytes)
        && (files.size() < 10 || files[9].fileData.size() <= maxBytes);
  }

  function isValidNotice(data) {
    return data is map
           && data.title is string
           && data.title.size() > 0
           && data.title.size() <= 100
           && data.content is string
           && data.content.size() <= 10000
           && data.authorId is string
           && data.authorName is string
           && data.date is string
           && data.timestamp is int
           && (!('tag' in data) || data.tag in ['학술 자료', '이벤트 안내', '설문 조사', '기타'])
           && (!('files' in data) || data.files is list)
           && (!('pinned' in data) || data.pinned is bool);
  }

  function isValidComment(data) {
    return data is map
           && data.content is string
           && data.content.size() > 0
           && data.content.size() <= 1000
           && data.authorId is string
           && data.authorName is string
           && data.date is string
           && data.timestamp is int;
  }

  function isValidFaq(data) {
    return data is map
           && data.title is string
           && data.title.size() > 0
           && data.title.size() <= 50
           && data.content is string
           && data.content.size() <= 3000
           && data.authorId is string
           && data.authorName is string
           && data.date is string
           && data.timestamp is int;
  }

  function isValidAnswer(data) {
    return data is map
           && data.content is string
           && data.content.size() > 0
           && data.content.size() <= 1000
           && data.authorId is string
           && data.authorName is string
           && data.date is string
           && data.timestamp is int;
  }

  // 이벤트 목록 카드. deadline은 마감 시각(밀리초). timestamp는 서버시각과 20분 이내여야 함.
  function isValidEvent(data) {
    return data is map
           && data.title is string
           && data.title.size() > 0
           && data.title.size() <= 100
           && data.authorId is string
           && data.authorName is string
           && data.date is string
           && data.timestamp is int
           && data.deadline is int
           && isFreshTimestamp(data.timestamp)
           && (!('files' in data) || data.files is list);
  }

  function isValidEventContent(data) {
    return data is map
           && data.content is string
           && data.content.size() <= 10000
           && (!('files' in data) || data.files is list);
  }

  function isValidLike(data, uid) {
    return data is map
           && data.keys().hasOnly(['uid', 'timestamp'])
           && data.uid == uid
           && data.timestamp is int;
  }

  function isValidUser(data) {
    return data is map
           && data.uid is string
           && data.uid == request.auth.uid
           && data.id is string
           && (data.id.matches('^[A-Za-z0-9_]{4,20}$') || data.id == request.auth.uid)
           && data.batch is string
           && (data.batch == '' || data.batch.matches('^[0-9][0-9].$'))
           && data.name is string
           && data.name.size() >= 3
           && data.name.size() <= 10
           && data.role == 'general'
           && (!('warnings' in data) || data.warnings == 0)
           && (!('email' in data))
           && (!('pwHash' in data))
           && (!('pw' in data));
  }

  // 본인 수정으로 바꿀 수 있는 것은 description과 (경고 확인 처리용)
  // hasUnseenWarning: false 뿐이다.
  //  - name을 잠그지 않으면 가입 후 이름만 바꿔 다른 부원을 사칭할 수 있다.
  //  - warnings/role은 관리자만 조정할 수 있다.
  function isValidUserUpdate(oldData, newData, isAdminActor) {
    return newData is map
           && newData.uid == oldData.uid
           && (newData.uid == request.auth.uid || isAdminActor)
           && newData.id == oldData.id
           && newData.batch == oldData.batch
           && newData.name is string
           && newData.name.size() >= 3
           && newData.name.size() <= 10
           && (isAdminActor || newData.name == oldData.name)
           && (isAdminActor || newData.role == oldData.role)
           && (isAdminActor || newData.warnings == oldData.warnings)
           && (isAdminActor
               || !newData.get('hasUnseenWarning', false)
               || oldData.get('hasUnseenWarning', false))
           && (!('description' in newData)
               || (newData.description is string && newData.description.size() <= 2000))
           && (!('pwHash' in newData))
           && (!('pw' in newData));
  }

  function isValidTraffic(data) {
    return data is map
           && data.keys().hasOnly(['y', 'm', 'd', 'noticeCount', 'eventCount', 'uploadBytes', 'downloadBytes', 'commentCount', 'faqQuestionCount'])
           && data.y is int && data.m is int && data.d is int
           && (!('noticeCount' in data) || (data.noticeCount is int && data.noticeCount >= 0 && data.noticeCount <= 1000))
           && (!('eventCount' in data) || (data.eventCount is int && data.eventCount >= 0 && data.eventCount <= 1000))
           && (!('uploadBytes' in data) || (data.uploadBytes is int && data.uploadBytes >= 0 && data.uploadBytes <= 1073741824))
           && (!('downloadBytes' in data) || (data.downloadBytes is int && data.downloadBytes >= 0 && data.downloadBytes <= 1073741824))
           && (!('commentCount' in data) || (data.commentCount is int && data.commentCount >= 0 && data.commentCount <= 1000))
           && (!('faqQuestionCount' in data) || (data.faqQuestionCount is int && data.faqQuestionCount >= 0 && data.faqQuestionCount <= 1000));
  }

  function isValidUsername(data) {
    return data is map
           && data.uid is string
           && data.uid == request.auth.uid
           && data.batch is string
           && (data.batch == '' || data.batch.matches('^[0-9][0-9].$'))
           && data.name is string
           && data.name.size() >= 3
           && data.name.size() <= 10;
  }

  // ---------------------------------------------------------------------------
  // 일일 한도 강제
  //
  // 예전에는 카운터 증가가 본문 쓰기와 별개의 요청이라, 클라이언트가 그냥
  // 증가를 호출하지 않으면 한도가 무의미했다(규칙이 traffic을 보지 않았음).
  //
  // getAfter()는 배치/트랜잭션이 커밋된 "후"의 상태를 보여준다. 이를 이용해
  // 본문 생성을 "같은 배치 안에서 카운터가 정확히 +1 되었을 것"에 묶으면,
  // 카운터를 빼먹은 단독 쓰기는 서버가 거부한다.
  //
  // 날짜를 문자열 대신 y/m/d 정수로 두는 이유: 규칙에는 zero-padding이 없어
  // 'YYYY-MM-DD' 문자열을 만들 수 없다. request.time은 UTC이므로 KST(+9h)로 옮겨
  // 비교하며, 지난 날짜의 카운터를 그대로 들고 오는 리셋 우회도 막힌다.
  // ---------------------------------------------------------------------------

  function trafficRef() {
    return /databases/(default)/documents/traffic/$(request.auth.uid);
  }

  function kstNow() {
    return request.time + duration.value(9, 'h');
  }

  function isTodayKst(d) {
    return d.get('y', 0) == kstNow().year()
           && d.get('m', 0) == kstNow().month()
           && d.get('d', 0) == kstNow().day();
  }

  // 커밋 후 카운터가 "오늘 날짜"로 정확히 +1 되었고 한도 이내인가?
  function quotaSpent(field, limit) {
    return isTodayKst(getAfter(trafficRef()).data)
           && getAfter(trafficRef()).data.get(field, -1) == expectedCount(field)
           && getAfter(trafficRef()).data.get(field, -1) <= limit;
  }

  // 오늘 첫 사용이면 1, 이미 오늘 기록이 있으면 직전 값 + 1.
  function expectedCount(field) {
    return (exists(trafficRef()) && isTodayKst(get(trafficRef()).data))
           ? get(trafficRef()).data.get(field, 0) + 1
           : 1;
  }

  // 관리자는 기존 동작대로 한도에서 제외된다.
  function underQuota(field, limit) {
    return isAdmin() || quotaSpent(field, limit);
  }

  // 클라이언트가 보낸 timestamp가 서버시각과 20분(1,200,000ms) 이내인지.
  // 컴퓨터 시계를 크게 조작한 상태의 쓰기를 서버가 거부한다.
  function isFreshTimestamp(ts) {
    return ts is int
           && request.time.toMillis() - ts <= 1200000
           && ts - request.time.toMillis() <= 1200000;
  }

  // 이벤트 본문 규칙에서 부모 이벤트 문서의 값을 읽어온다.
  function eventDeadline(database, eventId) {
    return get(/databases/$(database)/documents/events/$(eventId)).data.deadline;
  }

  function eventAuthorId(database, eventId) {
    return get(/databases/$(database)/documents/events/$(eventId)).data.authorId;
  }
}
